@namespace GISORA.Shared.Maps.Components
@implements IAsyncDisposable

@code {
    private const string ModulePath = "./_content/GISORA.Shared.Maps/js/map.js";

    private IJSObjectReference? _module;
    private DotNetObjectReference<DrawingTool>? _reference;

    [CascadingParameter]
    private MapView? Map { get; set; }

    [Parameter]
    public EventCallback<string> OnCompleted { get; set; }

    [Parameter]
    public EventCallback<string> OnEdited { get; set; }

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    public async Task StartDrawingAsync()
    {
        var module = await ModuleAsync();
        _reference ??= DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync("enableDraw", Map!.ElementId, _reference);
    }

    public async Task<bool> FinishDrawingAsync()
    {
        var module = await ModuleAsync();

        return await module.InvokeAsync<bool>("finishDraw", Map!.ElementId);
    }

    public async Task StartEditingAsync(string geoJson)
    {
        var module = await ModuleAsync();
        _reference ??= DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync("enableEdit", Map!.ElementId, geoJson, _reference);
    }

    public async Task CancelAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("cancelDraw", Map!.ElementId);
    }

    [JSInvokable]
    public async Task HandleGeometryCompleted(string geoJson) => await OnCompleted.InvokeAsync(geoJson);

    [JSInvokable]
    public async Task HandleGeometryEdited(string geoJson) => await OnEdited.InvokeAsync(geoJson);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("cancelDraw", Map?.ElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }

    private async ValueTask<IJSObjectReference> ModuleAsync()
        => _module ??= await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
}
