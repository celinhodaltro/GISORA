@namespace GISORA.Shared.Maps.Components
@implements IDisposable

<div class="gisora-layer-control" aria-label="Camadas do mapa">
    @foreach (var group in Layers.GroupBy(layer => layer.Group))
    {
        <div class="gisora-layer-control__group">
            @if (group.Key is not null)
            {
                <span class="gisora-layer-control__group-name">@group.Key</span>
            }

            @foreach (var layer in group)
            {
                <label class="gisora-layer-control__item">
                    <input type="checkbox" checked="@_applied.ContainsKey(layer.Id)" @onchange="args => ToggleAsync(layer, args)" />
                    <span>@layer.Name</span>
                </label>
            }
        </div>
    }
</div>

@code {
    private readonly Dictionary<string, string> _applied = [];

    [CascadingParameter]
    private MapView? Map { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<MapLayer> Layers { get; set; } = [];

    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false || Map is null)
        {
            return;
        }

        await SyncAsync();
    }

    public void Dispose() => _disposed = true;

    private async Task ToggleAsync(MapLayer layer, ChangeEventArgs args)
    {
        if (Map is null)
        {
            return;
        }

        if (args.Value is true)
        {
            await Map.SetLayerAsync(layer);
            _applied[layer.Id] = layer.GeoJson;
        }
        else
        {
            await Map.RemoveLayerAsync(layer.Id);
            _applied.Remove(layer.Id);
        }
    }

    private async Task SyncAsync()
    {
        if (Map is null || _disposed)
        {
            return;
        }

        var current = Layers.ToArray();

        foreach (var layerId in _applied.Keys.Except(current.Select(layer => layer.Id)).ToArray())
        {
            await Map.RemoveLayerAsync(layerId);
            _applied.Remove(layerId);
        }

        foreach (var layer in current.Where(layer => layer.Visible))
        {
            if (_applied.TryGetValue(layer.Id, out var geoJson) && geoJson == layer.GeoJson)
            {
                continue;
            }

            await Map.SetLayerAsync(layer);
            _applied[layer.Id] = layer.GeoJson;
        }

        await InvokeAsync(StateHasChanged);
    }
}
