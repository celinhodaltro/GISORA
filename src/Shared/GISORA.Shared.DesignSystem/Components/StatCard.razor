@namespace GISORA.Shared.DesignSystem.Components

<div class="gisora-stat-card">
    <span class="gisora-stat-card__label">@Label</span>
    <strong class="gisora-stat-card__value">@Value</strong>
    @if (Hint is not null)
    {
        <span class="gisora-stat-card__hint">@Hint</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }
}
