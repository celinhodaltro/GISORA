@page "/properties/new"
@using GISORA.Properties.Application.Commands
@using GISORA.Roads.Application
@using GISORA.Territory.Application
@inject NavigationManager Navigation
@inject CreatePropertyHandler CreateProperty
@inject ITerritoryQueries Territory
@inject IStreetQueries Streets

<PageHeader Title="Novo imovel" Description="Cadastro cadastral do lote." Icon="home_work" />

@if (_error is not null)
{
    <p class="property-form__error" role="alert">@_error</p>
}

<div class="property-form">
    <label class="property-form__field">
        <span>Setor</span>
        <RadzenTextBox @bind-Value="_sector" Placeholder="Setor" />
    </label>

    <label class="property-form__field">
        <span>Quadra</span>
        <RadzenTextBox @bind-Value="_block" Placeholder="Quadra" />
    </label>

    <label class="property-form__field">
        <span>Lote</span>
        <RadzenTextBox @bind-Value="_lot" Placeholder="Lote" />
    </label>

    <label class="property-form__field">
        <span>Unidade (opcional)</span>
        <RadzenTextBox @bind-Value="_unit" Placeholder="Unidade" />
    </label>

    <label class="property-form__field">
        <span>Bairro</span>
        <select class="property-form__select" @bind="_neighborhoodId" aria-label="Bairro">
            @foreach (var neighborhood in _neighborhoods)
            {
                <option value="@neighborhood.Id.Value">@neighborhood.Name</option>
            }
        </select>
    </label>

    <label class="property-form__field">
        <span>Logradouro</span>
        <select class="property-form__select" @bind="_streetId" aria-label="Logradouro">
            @foreach (var street in _streets)
            {
                <option value="@street.Id.Value">@street.Name</option>
            }
        </select>
    </label>

    <label class="property-form__field">
        <span>Numero</span>
        <RadzenTextBox @bind-Value="_number" Placeholder="Numero" />
    </label>

    <label class="property-form__field">
        <span>Complemento (opcional)</span>
        <RadzenTextBox @bind-Value="_complement" Placeholder="Complemento" />
    </label>

    <label class="property-form__field">
        <span>Area do lote (m2)</span>
        <RadzenNumeric TValue="decimal?" @bind-Value="_landArea" />
    </label>
</div>

<div class="property-form__actions">
    <RadzenButton Text="Salvar imovel" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" />
    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
</div>

@code {
    private IReadOnlyList<NeighborhoodListItem> _neighborhoods = [];
    private IReadOnlyList<StreetListItem> _streets = [];
    private Guid? _neighborhoodId;
    private Guid? _streetId;
    private string? _sector;
    private string? _block;
    private string? _lot;
    private string? _unit;
    private string? _number;
    private string? _complement;
    private decimal? _landArea;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _neighborhoods = await Territory.ListNeighborhoodsAsync();
        _streets = (await Streets.SearchAsync(new StreetFilter { PageSize = 500 })).Items;

        _neighborhoodId = _neighborhoods.FirstOrDefault()?.Id.Value;
        _streetId = _streets.FirstOrDefault()?.Id.Value;
    }

    private async Task SaveAsync()
    {
        if (_neighborhoodId is not { } neighborhoodId || _streetId is not { } streetId)
        {
            _error = "Cadastre bairro e logradouro antes de criar um imovel.";

            return;
        }

        var result = await CreateProperty.HandleAsync(new CreatePropertyCommand(
            _sector ?? string.Empty,
            _block ?? string.Empty,
            _lot ?? string.Empty,
            string.IsNullOrWhiteSpace(_unit) ? null : _unit,
            streetId,
            _number ?? string.Empty,
            neighborhoodId,
            _landArea ?? 0m,
            null));

        if (result.IsFailure)
        {
            _error = result.Error.Message;

            return;
        }

        Navigation.NavigateTo("/properties");
    }

    private void Cancel() => Navigation.NavigateTo("/properties");
}
