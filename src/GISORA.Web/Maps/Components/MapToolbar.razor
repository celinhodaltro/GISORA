@namespace GISORA.Web.Maps.Components

<div class="gisora-map-toolbar" role="toolbar" aria-label="Controles do mapa">
    <button type="button" title="Aproximar" aria-label="Aproximar" @onclick="ZoomInAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" /></svg>
    </button>

    <button type="button" title="Afastar" aria-label="Afastar" @onclick="ZoomOutAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v2H5z" /></svg>
    </button>

    <span class="gisora-map-toolbar__divider" aria-hidden="true"></span>

    <button type="button" title="Enquadrar camadas" aria-label="Enquadrar camadas" @onclick="FitAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5v2H6v3H4zm16 0h-2V6h-3V4h5v5zM4 15h2v3h3v2H4v-5zm16 0v5h-5v-2h3v-3h2z" /></svg>
    </button>
</div>

@code {
    [CascadingParameter]
    private MapView? Map { get; set; }

    private Task ZoomInAsync() => Map?.ZoomInAsync() ?? Task.CompletedTask;

    private Task ZoomOutAsync() => Map?.ZoomOutAsync() ?? Task.CompletedTask;

    private Task FitAsync() => Map?.FitBoundsAsync() ?? Task.CompletedTask;
}
