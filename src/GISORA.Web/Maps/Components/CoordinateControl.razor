@namespace GISORA.Web.Maps.Components
@implements IDisposable
@using System.Globalization

<footer class="gisora-map-status">
    <span class="gisora-map-status__crs">@Crs</span>

    @if (_coordinate is { } coordinate)
    {
        <span class="gisora-map-status__coordinate">
            @coordinate.Latitude.ToString("F5", CultureInfo.InvariantCulture),
            @coordinate.Longitude.ToString("F5", CultureInfo.InvariantCulture)
        </span>
    }
</footer>

@code {
    private MapCoordinate? _coordinate;

    [CascadingParameter]
    private MapView? Map { get; set; }

    [Parameter]
    public string Crs { get; set; } = "EPSG:4326";

    protected override void OnInitialized()
    {
        if (Map is not null)
        {
            Map.CoordinateChanged += OnCoordinateChanged;
        }
    }

    public void Dispose()
    {
        if (Map is not null)
        {
            Map.CoordinateChanged -= OnCoordinateChanged;
        }
    }

    private void OnCoordinateChanged(MapCoordinate coordinate)
    {
        _coordinate = coordinate;
        _ = InvokeAsync(StateHasChanged);
    }
}
