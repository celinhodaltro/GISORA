@namespace GISORA.Web.DesignSystem.Components

<div class="gisora-stat-card">
    <div class="gisora-stat-card__top">
        <span class="gisora-stat-card__label">@Label</span>
        @if (Icon is not null)
        {
            <span class="gisora-stat-card__icon" aria-hidden="true">
                <RadzenIcon Icon="@Icon" />
            </span>
        }
    </div>

    <strong class="gisora-stat-card__value">@Value</strong>

    @if (Hint is not null)
    {
        <span class="gisora-stat-card__hint">@Hint</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string? Icon { get; set; }
}
