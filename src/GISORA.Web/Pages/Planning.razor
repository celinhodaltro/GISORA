@page "/planning"
@using GISORA.Application.Geospatial
@using GISORA.Domain.Geospatial
@using GISORA.Application.Properties
@using GISORA.Web.Maps
@using GISORA.Web.Maps.Components
@using GISORA.Application.UrbanPlanning
@using GISORA.Application.UrbanPlanning.Commands
@using GISORA.Domain.UrbanPlanning
@inject IRegulationQueries Queries
@inject IPropertyMapQueries PropertyQueries
@inject CreateZoneHandler CreateZone
@inject CreateRestrictionHandler CreateRestriction
@inject IGeoJsonSerializer Serializer
@inject ISpatialOperations Spatial

<PageHeader Title="Zoneamento"
            Description="Zonas, parametros de ocupacao e restricoes incidentes sobre os imoveis."
            Icon="map" />

<div class="workspace">
    <div class="workspace__map">
        <MapView @ref="_map"
                 CenterLatitude="-7.95"
                 CenterLongitude="-35.25"
                 Zoom="15"
                 Height="var(--map-height-map)"
                 AutoFit="false"
                 OnReady="ApplyLayersAsync"
                 OnFeatureSelected="SelectPropertyAsync">
            <MapToolbar />
            <LayerControl Layers="_layers" />
            <CoordinateControl Crs="EPSG:4326" />
            <DrawingTool @ref="_tool" OnCompleted="CompleteDrawingAsync" />
        </MapView>
    </div>

    <aside class="workspace__side">
        <MapLegend Layers="_layers" />

        <RadzenCard>
            <h2 class="workspace__panel-title">Zona</h2>

            <div class="planning-form">
                <input class="territory-input" placeholder="Codigo da zona" @bind="_zoneCode" />
                <input class="territory-input" placeholder="Nome da zona" @bind="_zoneName" />
                <input class="territory-input" placeholder="Taxa de ocupacao (%)" @bind="_occupancy" />
                <input class="territory-input" placeholder="Gabarito (m)" @bind="_height" />
                <input class="territory-input" placeholder="Recuo minimo (m)" @bind="_setback" />
                <input class="territory-input" placeholder="Usos permitidos" @bind="_allowedUses" />

                <div class="gisora-toolbar">
                    <RadzenButton Text="Desenhar zona" Variant="Variant.Outlined" Click="@(() => StartDrawingAsync(DrawingTarget.Zone))" />
                    <RadzenButton Text="Concluir zona" Variant="Variant.Outlined" Click="FinishDrawingAsync" />
                </div>

                @if (_zoneAreaHectares is { } hectares)
                {
                    <p class="planning-area">Zona: @RuralMapProjector.Hectares(hectares)</p>
                }

                <RadzenButton Text="Salvar zona" ButtonStyle="ButtonStyle.Primary" Click="SaveZoneAsync" />
            </div>
        </RadzenCard>

        <RadzenCard>
            <h2 class="workspace__panel-title">Restricao</h2>

            <div class="planning-form">
                <select class="territory-select" @bind="_restrictionType" aria-label="Tipo de restricao">
                    @foreach (var type in RestrictionTypes)
                    {
                        <option value="@type">@RegulationMapProjector.RestrictionLabel(type)</option>
                    }
                </select>

                <input class="territory-input" placeholder="Descricao da restricao" @bind="_restrictionDescription" />

                <div class="gisora-toolbar">
                    <RadzenButton Text="Desenhar restricao" Variant="Variant.Outlined" Click="@(() => StartDrawingAsync(DrawingTarget.Restriction))" />
                    <RadzenButton Text="Concluir restricao" Variant="Variant.Outlined" Click="FinishDrawingAsync" />
                </div>

                @if (_restrictionAreaHectares is { } hectares)
                {
                    <p class="planning-area">Restricao: @RuralMapProjector.Hectares(hectares)</p>
                }

                <RadzenButton Text="Salvar restricao" ButtonStyle="ButtonStyle.Primary" Click="SaveRestrictionAsync" />
            </div>
        </RadzenCard>

        <RadzenCard>
            <h2 class="workspace__panel-title">Consulta por imovel</h2>

            <div class="planning-form">
                <select class="territory-select" @bind="_selectedPropertyId" aria-label="Imovel">
                    @foreach (var property in _properties)
                    {
                        <option value="@property.Id.Value">@property.Registration</option>
                    }
                </select>

                <RadzenButton Text="Consultar incidencia" Variant="Variant.Outlined" Click="QueryAsync" />

                @if (_incident is { } incident)
                {
                    <ul class="planning-incident" aria-label="Incidencia">
                        @foreach (var zone in incident.Zones)
                        {
                            <li class="planning-incident__item planning-zone">
                                <strong>@zone.Code</strong> @zone.Name
                                <span class="planning-incident__detail">
                                    @ZoneDetail(zone)
                                </span>
                            </li>
                        }

                        @foreach (var restriction in incident.Restrictions)
                        {
                            <li class="planning-incident__item planning-restriction">
                                @RegulationMapProjector.RestrictionLabel(restriction.Type): @restriction.Description
                            </li>
                        }
                    </ul>
                }

                @if (_error is not null)
                {
                    <p class="workspace__error" role="alert">@_error</p>
                }

                @if (_message is not null)
                {
                    <p class="workspace__message" role="status">@_message</p>
                }
            </div>
        </RadzenCard>
    </aside>
</div>

<RadzenCard>
    <h2 class="workspace__panel-title">Zonas cadastradas</h2>

    <RadzenDataGrid Data="@_zones" TItem="ZoneListItem" Density="Density.Compact" AllowPaging="false" EmptyText="Nenhuma zona cadastrada.">
        <Columns>
            <RadzenDataGridColumn TItem="ZoneListItem" Property="Code" Title="Codigo" Width="120px" />
            <RadzenDataGridColumn TItem="ZoneListItem" Property="Name" Title="Nome" />
            <RadzenDataGridColumn TItem="ZoneListItem" Title="Ocupacao" Width="120px">
                <Template Context="zone">
                    @(zone.MaxOccupancyPercent is { } value ? $"{value:N0}%" : "-")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ZoneListItem" Title="Gabarito" Width="120px">
                <Template Context="zone">
                    @(zone.MaxHeightMeters is { } value ? $"{value:N0} m" : "-")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private enum DrawingTarget
    {
        Zone,
        Restriction,
    }

    private static readonly RestrictionType[] RestrictionTypes = Enum.GetValues<RestrictionType>();

    private MapView? _map;
    private DrawingTool? _tool;
    private readonly List<MapLayer> _layers = [];

    private IReadOnlyList<ZoneListItem> _zones = [];
    private IReadOnlyList<PropertyMapItem> _properties = [];
    private IncidentRegulation? _incident;

    private Guid? _selectedPropertyId;
    private DrawingTarget _drawingTarget = DrawingTarget.Zone;

    private string? _zoneCode;
    private string? _zoneName;
    private string? _occupancy;
    private string? _height;
    private string? _setback;
    private string? _allowedUses;

    private RestrictionType _restrictionType = RestrictionType.RiskArea;
    private string? _restrictionDescription;

    private Polygon? _pendingBoundary;
    private decimal? _zoneAreaHectares;
    private decimal? _restrictionAreaHectares;

    private bool _applied;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ApplyLayersAsync()
    {
        if (_map is null || _applied)
        {
            return;
        }

        _applied = true;

        foreach (var layer in _layers)
        {
            await _map.SetLayerAsync(layer);
        }
    }

    private async Task ReloadAsync()
    {
        _zones = await Queries.ListZonesAsync();
        _properties = await PropertyQueries.GetMapItemsAsync();

        if (_selectedPropertyId is null && _properties.Count > 0)
        {
            _selectedPropertyId = _properties[0].Id.Value;
        }

        await RefreshLayersAsync();
    }

    private async Task RefreshLayersAsync()
    {
        var zones = await Queries.GetZoneMapItemsAsync();
        var restrictions = await Queries.GetRestrictionMapItemsAsync();

        _layers.Clear();

        if (_properties.Count > 0)
        {
            _layers.Add(new MapLayer(
                "planning-properties",
                "Imoveis",
                RegulationMapProjector.PropertiesToFeatureCollection(_properties, Serializer),
                Color: "#64748b"));
        }

        if (zones.Count > 0)
        {
            _layers.Add(new MapLayer(
                "planning-zones",
                "Zonas",
                RegulationMapProjector.ZonesToFeatureCollection(zones, Serializer),
                Color: "#1d4ed8",
                Legend: [new MapLegendItem("Zona", "#1d4ed8")]));
        }

        if (restrictions.Count > 0)
        {
            _layers.Add(new MapLayer(
                "planning-restrictions",
                "Restricoes",
                RegulationMapProjector.RestrictionsToFeatureCollection(restrictions, Serializer),
                Color: "#b45309",
                Legend: [new MapLegendItem("Restricao", "#b45309")]));
        }

        _applied = false;

        if (_map is not null && _map.IsReady)
        {
            await ApplyLayersAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task StartDrawingAsync(DrawingTarget target)
    {
        _drawingTarget = target;
        _error = null;

        await _tool!.StartDrawingAsync();
    }

    private async Task FinishDrawingAsync()
    {
        var completed = await _tool!.FinishDrawingAsync();

        if (completed is false)
        {
            _error = "Informe ao menos tres pontos para fechar o poligono.";
        }
    }

    private async Task CompleteDrawingAsync(string geoJson)
    {
        var geometry = Serializer.Deserialize(geoJson, SpatialReference.Wgs84);

        if (geometry is not Polygon polygon)
        {
            _error = "Desenhe um poligono.";
            return;
        }

        var hectares = (await Spatial.AreaAsync(polygon)).Hectares;
        _pendingBoundary = polygon;

        if (_drawingTarget == DrawingTarget.Zone)
        {
            _zoneAreaHectares = hectares;
        }
        else
        {
            _restrictionAreaHectares = hectares;
        }

        _error = null;
    }

    private async Task SaveZoneAsync()
    {
        if (_pendingBoundary is null)
        {
            _error = "Desenhe o perimetro da zona.";
            return;
        }

        var parameters = ZoneParameters.Create(
            ParseDecimal(_occupancy),
            ParseDecimal(_height),
            ParseDecimal(_setback),
            _allowedUses);

        var result = await CreateZone.HandleAsync(new CreateZoneCommand(
            _zoneCode ?? string.Empty,
            _zoneName ?? string.Empty,
            parameters,
            _pendingBoundary));

        if (result.IsFailure)
        {
            _error = result.Error.Message;
            _message = null;
            return;
        }

        _error = null;
        _message = "Zona cadastrada.";
        _zoneCode = null;
        _zoneName = null;
        _occupancy = null;
        _height = null;
        _setback = null;
        _allowedUses = null;
        _pendingBoundary = null;
        _zoneAreaHectares = null;

        await ReloadAsync();
    }

    private async Task SaveRestrictionAsync()
    {
        if (_pendingBoundary is null)
        {
            _error = "Desenhe o perimetro da restricao.";
            return;
        }

        var result = await CreateRestriction.HandleAsync(new CreateRestrictionCommand(
            _restrictionType,
            _restrictionDescription ?? string.Empty,
            _pendingBoundary));

        if (result.IsFailure)
        {
            _error = result.Error.Message;
            _message = null;
            return;
        }

        _error = null;
        _message = "Restricao cadastrada.";
        _restrictionDescription = null;
        _pendingBoundary = null;
        _restrictionAreaHectares = null;

        await ReloadAsync();
    }

    private async Task QueryAsync()
    {
        if (_selectedPropertyId is not { } propertyId)
        {
            _error = "Selecione um imovel.";
            return;
        }

        await QueryPropertyAsync(propertyId);
    }

    private async Task SelectPropertyAsync(MapFeature feature)
    {
        if (_layers.All(layer => layer.Id != "planning-properties") || Guid.TryParse(feature.Id, out var id) is false)
        {
            return;
        }

        _selectedPropertyId = id;
        await QueryPropertyAsync(id);
    }

    private async Task QueryPropertyAsync(Guid propertyId)
    {
        var property = _properties.FirstOrDefault(item => item.Id.Value == propertyId);

        if (property is null)
        {
            _error = "Imovel nao encontrado na camada.";
            return;
        }

        _incident = await Queries.FindIncidentAsync(property.Geometry);
        _error = null;
        _message = _incident.Zones.Count == 0 && _incident.Restrictions.Count == 0
            ? "Nenhuma zona ou restricao incide sobre o imovel."
            : null;

        await InvokeAsync(StateHasChanged);
    }

    private static string ZoneDetail(ZoneListItem zone)
    {
        var parts = new List<string>();

        if (zone.MaxOccupancyPercent is { } occupancy)
        {
            parts.Add($"ocupacao {occupancy:N0}%");
        }

        if (zone.MaxHeightMeters is { } height)
        {
            parts.Add($"gabarito {height:N0} m");
        }

        if (zone.MinSetbackMeters is { } setback)
        {
            parts.Add($"recuo {setback:N0} m");
        }

        if (zone.AllowedUses is { Length: > 0 } uses)
        {
            parts.Add(uses);
        }

        return string.Join(" | ", parts);
    }

    private static decimal? ParseDecimal(string? value)
        => decimal.TryParse(value, out var parsed) ? parsed : null;
}
