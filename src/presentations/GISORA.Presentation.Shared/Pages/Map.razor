@page "/map"
@using GISORA.Application.Geospatial
@using GISORA.Application.Properties
@using GISORA.Application.PublicFacilities
@using GISORA.Presentation.Shared.Maps
@using GISORA.Presentation.Shared.Maps.Components
@inject IPropertyMapQueries PropertyMapQueries
@inject IFacilityQueries FacilityQueries
@inject IGeoJsonSerializer Serializer

<PageHeader Title="Mapa"
            Description="Ambiente cartografico: camadas, legenda, selecao e atributos."
            Icon="map" />

<div class="workspace workspace--map">
    <div class="workspace__map">
        <MapView @ref="_map"
                 CenterLatitude="-7.95"
                 CenterLongitude="-35.25"
                 Zoom="12"
                 Height="var(--map-height-map)"
                 OnReady="ApplyLayersAsync">
            <MapToolbar />
            <LayerControl Layers="_layers" />
            <CoordinateControl Crs="EPSG:4326" />
            <FeatureSelector OnSelected="Select" />
        </MapView>
    </div>

    <aside class="workspace__side">
        <MapLegend Layers="_layers" />

        <RadzenCard class="workspace__panel">
            <h2 class="workspace__panel-title">Feicao selecionada</h2>

            @if (_selected is null)
            {
                <p class="workspace__panel-text">
                    Clique em um imovel ou equipamento no mapa para ver os atributos.
                </p>
            }
            else
            {
                <FeatureInspector Feature="_selected" Title="Atributos" />
            }
        </RadzenCard>
    </aside>
</div>

@code {
    private MapView? _map;
    private readonly List<MapLayer> _layers = [];
    private MapFeature? _selected;
    private bool _applied;

    protected override async Task OnInitializedAsync()
    {
        var propertyItems = await PropertyMapQueries.GetMapItemsAsync();
        var facilityItems = await FacilityQueries.GetMapItemsAsync();

        if (propertyItems.Count > 0)
        {
            _layers.Add(new MapLayer(
                "properties",
                "Imoveis",
                PropertyMapProjector.ToFeatureCollection(propertyItems, Serializer),
                Color: "#1f7a5c"));
        }

        if (facilityItems.Count > 0)
        {
            _layers.Add(new MapLayer(
                "facilities",
                "Equipamentos",
                FacilityMapProjector.ToFeatureCollection(facilityItems, Serializer),
                Color: "#1351b4"));
        }
    }

    private async Task ApplyLayersAsync()
    {
        if (_applied || _map is null)
        {
            return;
        }

        _applied = true;

        foreach (var layer in _layers)
        {
            await _map.SetLayerAsync(layer);
        }

        await _map.FitBoundsAsync();
    }

    private void Select(MapFeature feature)
    {
        _selected = feature;
        StateHasChanged();
    }
}
