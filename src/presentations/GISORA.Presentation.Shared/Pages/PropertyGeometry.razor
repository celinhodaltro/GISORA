@page "/properties/{PropertyId:guid}/geometry"
@using GISORA.Application.Geospatial
@using GISORA.Domain.Geospatial
@using GISORA.Application.Properties
@using GISORA.Application.Properties.Commands
@using GISORA.Domain.Properties
@using GISORA.Domain.Common
@using GISORA.Presentation.Shared.Maps
@using GISORA.Presentation.Shared.Maps.Components
@inject IPropertyQueries Queries
@inject IGeoJsonSerializer Serializer
@inject IPropertyGeometryValidator Validator
@inject ISpatialOperations Spatial
@inject UpdatePropertyGeometryHandler UpdateGeometry
@inject ClearPropertyGeometryHandler ClearGeometry

<PageHeader Title="Geometria do imovel" Description="Desenhe ponto, linha ou poligono do lote." Icon="draw" />

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (_view is null)
{
    <EmptyState Title="Imovel nao encontrado" Description="Volte para a listagem e selecione um imovel valido." />
}
else
{
    <p class="geometry-page__registration">Inscricao: <strong>@_view.Registration</strong></p>

    <p class="geometry-page__hint">Clique no mapa para adicionar vertices. Em <strong>ponto</strong> o clique conclui; em <strong>linha</strong> e <strong>poligono</strong> use <strong>Concluir desenho</strong>.</p>

    <div class="geometry-page">
        <MapView @ref="_map" CenterLatitude="-7.95" CenterLongitude="-35.25" Zoom="16" Height="clamp(22rem, calc(100vh - 26rem), 34rem)">
            <MapToolbar />
            <CoordinateControl />
            <DrawingTool @ref="_tool" OnCompleted="CompleteGeometryAsync" OnEdited="ApplyGeometryAsync" />
        </MapView>
    </div>

    <div class="gisora-toolbar geometry-page__actions">
        <RadzenButton Text="Desenhar ponto" Variant="Variant.Outlined" Click="@(() => DrawAsync("Point"))" />
        <RadzenButton Text="Desenhar linha" Variant="Variant.Outlined" Click="@(() => DrawAsync("LineString"))" />
        <RadzenButton Text="Desenhar poligono" Variant="Variant.Outlined" Click="@(() => DrawAsync("Polygon"))" />
        <RadzenButton Text="Concluir desenho" Variant="Variant.Outlined" Click="FinishAsync" />
        <RadzenButton Text="Desfazer ultimo vertice" Variant="Variant.Outlined" Click="UndoAsync" />
        <RadzenButton Text="Editar geometria" Variant="Variant.Outlined" Disabled="@(_geometry is null && _view.Geometry is null)" Click="EditAsync" />
        <RadzenButton Text="Salvar geometria" ButtonStyle="ButtonStyle.Primary" Disabled="@(_geometry is not Polygon || _diagnostics.Count > 0)" Click="SaveAsync" />
        <RadzenButton Text="Remover geometria" ButtonStyle="ButtonStyle.Danger" Disabled="@(_geometry is null && _view.Geometry is null)" Click="AskRemoveAsync" />
        <RadzenButton Text="Cancelar" Variant="Variant.Outlined" Click="CancelAsync" />
    </div>

    @if (_confirmingRemoval)
    {
        <p class="geometry-page__error" role="alert">Confirma a remocao da geometria deste imovel?</p>

        <div class="gisora-toolbar geometry-page__actions">
            <RadzenButton Text="Confirmar remocao" ButtonStyle="ButtonStyle.Danger" Click="RemoveGeometryAsync" />
            <RadzenButton Text="Cancelar remocao" Variant="Variant.Outlined" Click="CancelRemovalAsync" />
        </div>
    }

    @if (_areaSquareMeters is { } area)
    {
        <p class="geometry-page__area">Area calculada: @area.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) m2</p>
    }

    @if (_summary is not null)
    {
        <p class="geometry-page__area">@_summary</p>
    }

    @if (_diagnostics.Count > 0)
    {
        <div class="geometry-page__diagnostics" role="alert">
            <p>Corrija a geometria antes de salvar:</p>
            <ul>
                @foreach (var issue in _diagnostics)
                {
                    <li>@DiagnosticText(issue)</li>
                }
            </ul>
        </div>
    }

    @if (_error is not null)
    {
        <p class="geometry-page__error" role="alert">@_error</p>
    }

    @if (_message is not null)
    {
        <p class="geometry-page__message" role="status">@_message</p>
    }
}

@code {
    private MapView? _map;
    private DrawingTool? _tool;
    private PropertyGeometryView? _view;
    private Geometry? _geometry;
    private decimal? _areaSquareMeters;
    private string? _summary;
    private string _drawingKind = "Polygon";
    private bool _confirmingRemoval;
    private bool _loading = true;
    private bool _layerApplied;
    private string? _error;
    private string? _message;
    private IReadOnlyList<GeometryIssue> _diagnostics = [];

    [Parameter]
    public Guid PropertyId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _view = await Queries.GetGeometryAsync(new PropertyId(PropertyId));
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _layerApplied || _map is null)
        {
            return;
        }

        _layerApplied = true;

        if (_view?.Geometry is null)
        {
            return;
        }

        await ShowGeometryAsync(_view.Geometry);
    }

    private async Task DrawAsync(string kind)
    {
        _error = null;
        _message = null;
        _diagnostics = [];
        _confirmingRemoval = false;
        _drawingKind = kind;

        await _tool!.StartDrawingAsync(kind);
    }

    private async Task EditAsync()
    {
        var geometry = _geometry ?? _view?.Geometry;

        if (geometry is null)
        {
            _error = "Nao ha geometria para editar.";

            return;
        }

        if (geometry is GISORA.Domain.Geospatial.Point)
        {
            _error = "Ponto nao possui vertices para editar.";

            return;
        }

        _error = null;
        _message = null;
        _diagnostics = [];
        await _tool!.StartEditingAsync(Serializer.Serialize(geometry));
    }

    private async Task FinishAsync()
    {
        var completed = await _tool!.FinishDrawingAsync();

        if (completed is false)
        {
            _error = _drawingKind switch
            {
                "Point" => "Clique no mapa para marcar o ponto.",
                "LineString" => "Informe ao menos dois pontos para concluir a linha.",
                _ => "Informe ao menos tres pontos para fechar o poligono.",
            };
        }
    }

    private async Task UndoAsync()
    {
        _error = null;
        await _tool!.UndoLastVertexAsync();
    }

    private async Task CompleteGeometryAsync(string geoJson)
    {
        var geometry = await ReadGeometryAsync(geoJson);

        if (geometry is null)
        {
            return;
        }

        await ShowGeometryAsync(geometry);
    }

    private async Task ApplyGeometryAsync(string geoJson) => await ReadGeometryAsync(geoJson);

    private async Task<Geometry?> ReadGeometryAsync(string geoJson)
    {
        Geometry geometry;

        try
        {
            geometry = Serializer.Deserialize(geoJson, SpatialReference.Wgs84);
        }
        catch (DomainException exception)
        {
            _geometry = null;
            _areaSquareMeters = null;
            _summary = null;
            _error = null;
            _diagnostics = [new GeometryIssue(exception.Code, exception.Message)];

            return null;
        }
        catch (Exception)
        {
            _geometry = null;
            _areaSquareMeters = null;
            _summary = null;
            _error = "Geometria invalida.";
            _diagnostics = [];

            return null;
        }

        if (geometry is Polygon polygon)
        {
            var validation = await Validator.ValidateAsync(polygon, new PropertyId(PropertyId));

            if (validation.IsValid is false)
            {
                _geometry = null;
                _areaSquareMeters = null;
                _summary = null;
                _error = null;
                _diagnostics = validation.Issues;

                return null;
            }
        }

        _geometry = geometry;
        _error = null;
        _message = null;
        _diagnostics = [];
        await UpdateMeasurementAsync(geometry);

        return geometry;
    }

    private async Task UpdateMeasurementAsync(Geometry geometry)
    {
        if (geometry is Polygon polygon)
        {
            _areaSquareMeters = (await Spatial.AreaAsync(polygon)).SquareMeters;
            _summary = null;

            return;
        }

        _areaSquareMeters = null;
        _summary = $"Tipo: {geometry.Type} — coordenadas: {string.Join("; ", geometry.Coordinates.Select(FormatCoordinate))}";
    }

    private static string FormatCoordinate(Coordinate coordinate)
        => $"({coordinate.X.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}, {coordinate.Y.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)})";

    private static string DiagnosticText(GeometryIssue issue)
        => issue.Location is { } location
            ? $"{issue.Message} Local: {FormatCoordinate(location)}."
            : issue.Message;

    private async Task SaveAsync()
    {
        if (_geometry is not Polygon polygon)
        {
            _error = "Poligono e o unico tipo persistido no cadastro do imovel.";

            return;
        }

        var result = await UpdateGeometry.HandleAsync(
            new UpdatePropertyGeometryCommand(new PropertyId(PropertyId), polygon, null));

        if (result.IsFailure)
        {
            _message = null;

            if (result.Error.Code == PropertyGeometryValidator.OverlapCode)
            {
                _error = null;
                _diagnostics = [new GeometryIssue(result.Error.Code, result.Error.Message)];
                _geometry = null;
            }
            else
            {
                _error = result.Error.Message;
            }

            return;
        }

        _error = null;
        _diagnostics = [];
        _message = "Geometria atualizada.";
        _view = _view is null ? null : _view with { Geometry = polygon };
        await ShowGeometryAsync(polygon);
    }

    private void AskRemoveAsync()
    {
        _error = null;
        _message = null;
        _diagnostics = [];
        _confirmingRemoval = true;
    }

    private void CancelRemovalAsync()
    {
        _confirmingRemoval = false;
    }

    private async Task RemoveGeometryAsync()
    {
        _confirmingRemoval = false;

        if (_view is not null && _view.Geometry is not null)
        {
            var result = await ClearGeometry.HandleAsync(new ClearPropertyGeometryCommand(
                new PropertyId(PropertyId),
                "remocao solicitada na tela de geometria do imovel"));

            if (result.IsFailure)
            {
                _error = result.Error.Message;

                return;
            }

            _view = _view with { Geometry = null };
        }

        _geometry = null;
        _areaSquareMeters = null;
        _summary = null;
        _error = null;
        _diagnostics = [];
        _message = "Geometria removida.";

        if (_map is not null)
        {
            await _map.RemoveLayerAsync("property-geometry");
        }
    }

    private async Task CancelAsync()
    {
        await _tool!.CancelAsync();
        _error = null;
        _message = null;
        _diagnostics = [];
    }

    private async Task ShowGeometryAsync(Geometry geometry)
    {
        if (_map is null)
        {
            return;
        }

        var geoJson = Serializer.Serialize(geometry);
        var feature = $$"""
            {
              "type": "FeatureCollection",
              "features": [{
                "type": "Feature",
                "id": "{{PropertyId}}",
                "properties": { "inscricao": "{{_view?.Registration}}" },
                "geometry": {{geoJson}}
              }]
            }
            """;

        await _map.SetLayerAsync(new MapLayer("property-geometry", "Geometria", feature, Color: "#1f7a5c"));
        await _map.FitBoundsAsync();
    }
}
