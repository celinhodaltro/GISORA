@page "/data"
@using System.Text.Json
@using GISORA.Application.Common
@using GISORA.Application.Geospatial
@using GISORA.Application.Properties.Commands
@inject IBackupService Backup
@inject ImportPropertyGeometryHandler ImportGeometry
@inject PropertyGeoJsonExportHandler ExportGeometry
@inject IGeometryImportLog Imports
@inject IJSRuntime Js

<PageHeader Title="Dados e backup"
            Description="Exporte, valide e restaure o estado local do GISORA."
            Icon="database" />

<div class="backup-layout">
    <RadzenCard>
        <h2 class="backup-title">Backup do armazenamento local</h2>

        <p class="backup-text">
            O backup inclui todos os registros do GISORA no <code>localStorage</code> deste navegador,
            com a versao do schema de dados.
        </p>

        <div class="backup-actions">
            <RadzenButton Text="Exportar backup" ButtonStyle="ButtonStyle.Primary" Click="ExportAsync" />
            <span class="backup-hint">Arquivo JSON gerado localmente, sem envio para servidor.</span>
        </div>

        <hr class="backup-divider" />

        <h3 class="backup-subtitle">Restaurar backup</h3>

        <InputFile OnChange="LoadAsync" accept=".json,application/json" class="backup-file" aria-label="Arquivo de backup" />

        @if (_fileName is not null)
        {
            <p class="backup-file-name">Arquivo: <strong>@_fileName</strong></p>
        }

        @if (_validation is { } validation)
        {
            <div class="backup-validation">
                <p><strong>Versao do backup:</strong> @validation.Manifest?.SchemaVersion / atual @validation.CurrentSchemaVersion</p>
                <p><strong>Registros:</strong> @(validation.Manifest?.Records.Count ?? 0)</p>
                @if (validation.Manifest is { } manifest)
                {
                    <p><strong>Exportado em:</strong> @manifest.ExportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        }

        <label class="backup-field">
            <span>Modo de restauracao</span>
            <select class="backup-select" @bind="_mode" aria-label="Modo de restauracao">
                <option value="@BackupRestoreMode.Merge">Mesclar (preserva dados existentes)</option>
                <option value="@BackupRestoreMode.Replace">Substituir (apaga os dados atuais)</option>
            </select>
        </label>

        <label class="backup-check">
            <input type="checkbox" @bind="_confirmed" />
            <span>Confirmo que a restauracao altera os dados locais deste navegador.</span>
        </label>

        <RadzenButton Text="@(_restoring ? "Restaurando..." : "Restaurar backup")"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@(_restoring || _confirmed is false || _validation is not { IsValid: true })"
                      Click="RestoreAsync" />

        @if (_error is not null)
        {
            <p class="workspace__error" role="alert">@_error</p>
        }

        @if (_message is not null)
        {
            <p class="workspace__message" role="status">@_message</p>
        }
    </RadzenCard>

    <RadzenCard>
        <h2 class="backup-title">Limites do armazenamento local</h2>

        <ul class="backup-limits">
            <li>Os dados ficam apenas neste navegador e neste perfil; nao ha sincronizacao entre dispositivos.</li>
            <li>O <code>localStorage</code> nao e um mecanismo seguro e pode ser apagado manualmente.</li>
            <li>O limite varia por navegador e costuma ser de poucos megabytes; backups grandes podem falhar.</li>
            <li>A restauracao substitui ou mescla os registros conforme o modo escolhido.</li>
            <li>Arquivos de imagem e outros binarios nao entram no backup.</li>
        </ul>
    </RadzenCard>
</div>

<div class="backup-layout">
    <RadzenCard>
        <h2 class="backup-title">Importar GeoJSON de imoveis</h2>

        <p class="backup-text">
            Atualiza a geometria de imoveis existentes identificados pelo <code>id</code> ou pela
            <code>inscricao</code> da feicao. Nenhum imovel novo e criado: feicoes sem correspondencia
            sao informadas e descartadas.
        </p>

        <InputFile OnChange="LoadGeoJsonAsync"
                   accept=".geojson,.json,application/geo+json,application/json"
                   class="backup-file"
                   aria-label="Arquivo GeoJSON" />

        @if (_geoJsonFileName is not null)
        {
            <p class="backup-file-name">Arquivo: <strong>@_geoJsonFileName</strong></p>
        }

        <label class="backup-field">
            <span>CRS de origem</span>
            <select class="backup-select" @bind="_importSourceCrs" aria-label="CRS de origem">
                <option value="">Detectar nos metadados (padrao EPSG:4326)</option>
                @foreach (var option in CrsCatalog.Supported)
                {
                    <option value="@option.Identifier">@option.Identifier - @option.Name</option>
                }
            </select>
        </label>

        <label class="backup-field">
            <span>CRS de trabalho (saida)</span>
            <select class="backup-select" @bind="_importTargetCrs" aria-label="CRS de trabalho">
                @foreach (var option in CrsCatalog.Supported)
                {
                    <option value="@option.Identifier">@option.Identifier - @option.Name</option>
                }
            </select>
        </label>

        <RadzenButton Text="@(_importing ? "Importando..." : "Importar GeoJSON")"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@(_importing || _geoJson is null)"
                      Click="ImportAsync" />

        <p class="backup-hint">Limite de 10 MB e 5000 feicoes por arquivo.</p>

        @if (_importError is not null)
        {
            <p class="workspace__error" role="alert">@_importError</p>
        }

        @if (_importMessage is not null)
        {
            <p class="workspace__message" role="status">@_importMessage</p>
        }

        @if (_importSkipped.Count > 0)
        {
            <ul class="backup-limits">
                @foreach (var item in _importSkipped)
                {
                    <li>@item</li>
                }
            </ul>
        }
    </RadzenCard>

    <RadzenCard>
        <h2 class="backup-title">Exportar imoveis em GeoJSON</h2>

        <p class="backup-text">
            Gera um <code>FeatureCollection</code> com tipo, propriedades e metadados de origem, data e CRS.
            O arquivo gerado pode ser reimportado nesta tela.
        </p>

        <label class="backup-field">
            <span>Filtrar por inscricao</span>
            <RadzenTextBox @bind-Value="_exportFilter" Placeholder="Filtro opcional" aria-label="Filtrar por inscricao" />
        </label>

        <label class="backup-field">
            <span>CRS de saida</span>
            <select class="backup-select" @bind="_exportCrs" aria-label="CRS de saida">
                @foreach (var option in CrsCatalog.Supported)
                {
                    <option value="@option.Identifier">@option.Identifier - @option.Name</option>
                }
            </select>
        </label>

        <RadzenButton Text="Exportar GeoJSON"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="ExportGeoJsonAsync" />

        @if (_exportError is not null)
        {
            <p class="workspace__error" role="alert">@_exportError</p>
        }

        @if (_exportMessage is not null)
        {
            <p class="workspace__message" role="status">@_exportMessage</p>
        }
    </RadzenCard>
</div>

<RadzenCard>
    <h2 class="backup-title">Importacoes de geometria</h2>

    <RadzenDataGrid Data="@_imports"
                    TItem="GeometryImportRecord"
                    Density="Density.Compact"
                    AllowPaging="false"
                    EmptyText="Nenhuma importacao de geometria registrada.">
        <Columns>
            <RadzenDataGridColumn TItem="GeometryImportRecord" Property="Registration" Title="Inscricao" Width="180px" />
            <RadzenDataGridColumn TItem="GeometryImportRecord" Property="Origin" Title="Origem" />
            <RadzenDataGridColumn TItem="GeometryImportRecord" Property="SourceCrs" Title="CRS origem" Width="120px" />
            <RadzenDataGridColumn TItem="GeometryImportRecord" Property="TargetCrs" Title="CRS destino" Width="120px" />
            <RadzenDataGridColumn TItem="GeometryImportRecord" Property="FeatureCount" Title="Feicoes" Width="90px" />
            <RadzenDataGridColumn TItem="GeometryImportRecord" Title="Importado em" Width="170px">
                <Template Context="record">
                    @record.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private static readonly JsonSerializerOptions ExportOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
    };

    private BackupRestoreMode _mode = BackupRestoreMode.Merge;
    private BackupValidation? _validation;
    private string? _fileName;
    private string? _json;
    private string? _error;
    private string? _message;
    private bool _confirmed;
    private bool _restoring;
    private string? _geoJson;
    private string? _geoJsonFileName;
    private string _importSourceCrs = string.Empty;
    private string _importTargetCrs = CrsCatalog.Wgs84.Identifier;
    private bool _importing;
    private string? _importError;
    private string? _importMessage;
    private IReadOnlyList<string> _importSkipped = [];
    private IReadOnlyList<GeometryImportRecord> _imports = [];
    private string? _exportFilter;
    private string _exportCrs = CrsCatalog.Wgs84.Identifier;
    private string? _exportError;
    private string? _exportMessage;

    protected override async Task OnInitializedAsync() => await LoadImportsAsync();

    private async Task LoadImportsAsync() => _imports = await Imports.ListAsync();

    private async Task LoadGeoJsonAsync(InputFileChangeEventArgs args)
    {
        _importError = null;
        _importMessage = null;
        _importSkipped = [];
        _geoJson = null;
        _geoJsonFileName = null;

        try
        {
            using var stream = args.File.OpenReadStream(GeoJsonLimits.MaxBytes);
            using var reader = new StreamReader(stream);

            _geoJson = await reader.ReadToEndAsync();
            _geoJsonFileName = args.File.Name;
        }
        catch (IOException)
        {
            _importError = $"Nao foi possivel ler o arquivo. O limite e de {GeoJsonLimits.MaxBytes / (1024 * 1024)} MB.";
        }
    }

    private async Task ImportAsync()
    {
        if (_geoJson is null)
        {
            _importError = "Selecione um arquivo GeoJSON.";
            return;
        }

        _importError = null;
        _importMessage = null;
        _importSkipped = [];
        _importing = true;

        try
        {
            var result = await ImportGeometry.HandleAsync(new ImportPropertyGeometryCommand(
                _geoJsonFileName ?? "arquivo.geojson",
                _geoJson,
                string.IsNullOrWhiteSpace(_importSourceCrs) ? null : _importSourceCrs,
                _importTargetCrs));

            if (result.IsFailure)
            {
                _importError = result.Error.Message;
                return;
            }

            _importMessage = $"{result.Value.Updated.Count} imovel(is) atualizado(s) de {result.Value.FeatureCount} feicao(oes) em {_importTargetCrs}.";
            _importSkipped = result.Value.Skipped;
            _geoJson = null;
            _geoJsonFileName = null;

            await LoadImportsAsync();
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ExportGeoJsonAsync()
    {
        _exportError = null;
        _exportMessage = null;

        var result = await ExportGeometry.ExportSetAsync(_exportFilter, _exportCrs);

        if (result.IsFailure)
        {
            _exportError = result.Error.Message;
            return;
        }

        try
        {
            await DownloadAsync(result.Value.FileName, result.Value.Content);

            _exportMessage = $"GeoJSON exportado com {result.Value.FeatureCount} feicao(oes) em {result.Value.TargetCrs}.";
        }
        catch (JSException)
        {
            _exportError = "Nao foi possivel gerar o arquivo GeoJSON neste navegador.";
        }
    }

    private async Task DownloadAsync(string fileName, string content)
    {
        var module = await Js.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/GISORA.Infrastructure/js/localstore.js");

        await module.InvokeVoidAsync("downloadText", fileName, content);
    }

    private async Task ExportAsync()
    {
        _error = null;
        _message = null;

        try
        {
            var manifest = await Backup.ExportAsync();
            var json = JsonSerializer.Serialize(manifest, ExportOptions);
            var module = await Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/GISORA.Infrastructure/js/localstore.js");

            await module.InvokeVoidAsync(
                "downloadText",
                $"gisora-backup-{DateTime.Now:yyyyMMdd-HHmm}.json",
                json);

            _message = $"Backup exportado com {manifest.Records.Count} registros.";
        }
        catch (JSException)
        {
            _error = "Nao foi possivel gerar o arquivo de backup neste navegador.";
        }
    }

    private async Task LoadAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        _message = null;
        _validation = null;
        _confirmed = false;

        try
        {
            using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);

            _json = await reader.ReadToEndAsync();
            _fileName = args.File.Name;
            _validation = await Backup.ValidateAsync(_json);

            if (_validation.IsValid is false)
            {
                _error = string.Join(" ", _validation.Errors);
            }
        }
        catch (IOException)
        {
            _error = "Nao foi possivel ler o arquivo selecionado.";
        }
    }

    private async Task RestoreAsync()
    {
        if (_json is null || _validation is not { IsValid: true })
        {
            return;
        }

        _error = null;
        _message = null;
        _restoring = true;

        try
        {
            var result = await Backup.RestoreAsync(_json, _mode);

            if (result.Success is false)
            {
                _error = result.Error;
                return;
            }

            _message = $"{result.Restored} registros restaurados. Recarregue a pagina para ver os dados.";
            _validation = null;
            _json = null;
            _fileName = null;
            _confirmed = false;
        }
        finally
        {
            _restoring = false;
        }
    }
}
