@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject MunicipalityState Municipality
@inject IJSRuntime Js

<a class="app-skip-link" href="#main-content" @onclick="FocusMainAsync" @onclick:preventDefault>Ir para o conteudo principal</a>

<div class="app-shell @(Collapsed ? "app-shell--collapsed" : null)">
    <AppHeader Collapsed="Collapsed" Expanded="@(!Collapsed || MobileOpen)" Municipality="@Municipality.Name" OnToggle="Toggle" />

    <div class="app-body">
        <NavMenu Collapsed="Collapsed" MobileOpen="MobileOpen" OnNavigate="CloseMobile" />

        @if (MobileOpen)
        {
            <button type="button" class="app-backdrop" aria-label="Fechar menu" @onclick="CloseMobile"></button>
        }

        <main id="main-content" @ref="_mainContent" class="app-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private ElementReference _mainContent;
    private bool _collapsed;
    private bool _mobileOpen;

    public bool Collapsed => _collapsed;

    public bool MobileOpen => _mobileOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        Municipality.Changed += HandleMunicipalityChanged;
        await Municipality.RefreshAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        Municipality.Changed -= HandleMunicipalityChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(async () =>
        {
            await Municipality.RefreshAsync();
            StateHasChanged();
        });

    private void HandleMunicipalityChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        _collapsed = !_collapsed;
        _mobileOpen = !_mobileOpen;
    }

    private void CloseMobile() => _mobileOpen = false;

    private async Task FocusMainAsync()
    {
        var module = await Js.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/GISORA.Presentation.Shared/js/a11y.js");

        await module.InvokeVoidAsync("focus", _mainContent);
    }
}
