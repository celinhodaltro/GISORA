@namespace GISORA.Presentation.Shared.DesignSystem.Components

<div class="gisora-empty-state">
    <strong class="gisora-empty-state__title">@Title</strong>
    @if (Description is not null)
    {
        <p class="gisora-empty-state__description">@Description</p>
    }

    @if (Action is not null)
    {
        <div class="gisora-empty-state__action">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Action { get; set; }
}
