@namespace GISORA.Presentation.Shared.Maps.Components
@implements IAsyncDisposable

@code {
    private const string ModulePath = "./_content/GISORA.Presentation.Shared/js/map.js?v=3";

    private IJSObjectReference? _module;
    private DotNetObjectReference<DrawingTool>? _reference;

    [CascadingParameter]
    private MapView? Map { get; set; }

    [Parameter]
    public IReadOnlyList<MapDrawingMode> Modes { get; set; } = [];

    [Parameter]
    public bool ShowToolbarTrigger { get; set; } = true;

    [Parameter]
    public EventCallback<string> OnCompleted { get; set; }

    [Parameter]
    public EventCallback<string> OnEdited { get; set; }

    [Parameter]
    public EventCallback<MapCoordinate> OnPointPicked { get; set; }

    [Parameter]
    public EventCallback OnCanceled { get; set; }

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    public MapDrawingMode? ActiveMode { get; private set; }

    public MapDrawingMode? CompletedMode { get; private set; }

    public bool IsDrawing { get; private set; }

    public bool IsEditing { get; private set; }

    public bool IsActive => IsDrawing || IsEditing;

    public bool CanFinish => IsDrawing && ActiveMode is { Kind: not "Point" and not "Pick" };

    public bool CanUndo => CanFinish;

    public string? Error { get; private set; }

    protected override void OnInitialized() => Map?.AttachDrawingTool(this);

    public async Task StartAsync(MapDrawingMode mode)
    {
        ArgumentNullException.ThrowIfNull(mode);

        var module = await ModuleAsync();
        _reference ??= DotNetObjectReference.Create(this);

        ActiveMode = mode;
        CompletedMode = null;
        IsDrawing = true;
        IsEditing = false;
        Error = null;
        Map?.NotifyDrawingStateChanged();

        if (mode.Kind == "Pick")
        {
            await module.InvokeVoidAsync("enablePointPick", Map!.ElementId, _reference);

            return;
        }

        await module.InvokeVoidAsync("enableDraw", Map!.ElementId, _reference, mode.Kind);
    }

    public async Task FinishAsync()
    {
        if (_module is null || IsDrawing is false)
        {
            return;
        }

        var completed = await _module.InvokeAsync<bool>("finishDraw", Map!.ElementId);
        Error = completed ? null : MinimumMessage(ActiveMode?.Kind);
        Map?.NotifyDrawingStateChanged();
    }

    public async Task UndoAsync()
    {
        if (_module is null || IsDrawing is false)
        {
            return;
        }

        await _module.InvokeVoidAsync("undoLastVertex", Map!.ElementId);
        Error = null;
        Map?.NotifyDrawingStateChanged();
    }

    public async Task StartEditingAsync(string geoJson)
    {
        var module = await ModuleAsync();
        _reference ??= DotNetObjectReference.Create(this);

        ActiveMode = null;
        CompletedMode = null;
        IsDrawing = false;
        IsEditing = true;
        Error = null;
        Map?.NotifyDrawingStateChanged();

        await module.InvokeVoidAsync("enableEdit", Map!.ElementId, geoJson, _reference);
    }

    public async Task CancelAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("cancelDraw", Map!.ElementId);
        }

        Reset();
        await OnCanceled.InvokeAsync();
    }

    [JSInvokable]
    public async Task HandleGeometryCompleted(string geoJson)
    {
        CompletedMode = ActiveMode;
        Reset();

        await OnCompleted.InvokeAsync(geoJson);
    }

    [JSInvokable]
    public async Task HandleGeometryEdited(string geoJson) => await OnEdited.InvokeAsync(geoJson);

    [JSInvokable]
    public async Task HandlePointPicked(double latitude, double longitude)
        => await OnPointPicked.InvokeAsync(new MapCoordinate(latitude, longitude));

    [JSInvokable]
    public async Task HandleDrawingCanceled()
    {
        Reset();
        await OnCanceled.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Map?.DetachDrawingTool(this);

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("cancelDraw", Map?.ElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }

    private void Reset()
    {
        IsDrawing = false;
        IsEditing = false;
        ActiveMode = null;
        Error = null;
        Map?.NotifyDrawingStateChanged();
    }

    private static string MinimumMessage(string? kind) => kind switch
    {
        "Point" => "Clique no mapa para marcar o ponto.",
        "LineString" => "Informe ao menos dois pontos para concluir a linha.",
        _ => "Informe ao menos tres pontos para fechar o poligono.",
    };

    private async ValueTask<IJSObjectReference> ModuleAsync()
        => _module ??= await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
}
