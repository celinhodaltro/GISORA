@namespace GISORA.Presentation.Shared.Maps.Components
@implements IDisposable

<div class="gisora-map-toolbar" role="toolbar" aria-label="Controles do mapa">
    <button type="button" title="Aproximar" aria-label="Aproximar" @onclick="ZoomInAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" /></svg>
    </button>

    <button type="button" title="Afastar" aria-label="Afastar" @onclick="ZoomOutAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v2H5z" /></svg>
    </button>

    <span class="gisora-map-toolbar__divider" aria-hidden="true"></span>

    <button type="button" title="Enquadrar camadas" aria-label="Enquadrar camadas" @onclick="FitAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5v2H6v3H4zm16 0h-2V6h-3V4h5v5zM4 15h2v3h3v2H4v-5zm16 0v5h-5v-2h3v-3h2z" /></svg>
    </button>

    @if (CanEditSelection)
    {
        <button type="button" title="Editar geometria" aria-label="Editar geometria" @onclick="EditSelectionAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.3V21h3.7L17.9 9.8l-3.7-3.7zm17.7-10.5c.4-.4.4-1 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0l-1.8 1.8 3.7 3.7z" /></svg>
        </button>
    }

    @if (Tool is { } tool)
    {
        <span class="gisora-map-toolbar__divider" aria-hidden="true"></span>

        @if (tool.IsActive)
        {
            @if (tool.CanFinish)
            {
                <button type="button" title="Concluir desenho" aria-label="Concluir desenho" @onclick="tool.FinishAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                </button>
            }

            @if (tool.CanUndo)
            {
                <button type="button" title="Desfazer ultimo vertice" aria-label="Desfazer ultimo vertice" @onclick="tool.UndoAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.5 8c-2.7 0-5 1.1-6.7 2.9L2 7v9h9l-3.6-3.6C8.8 11 10.5 10 12.5 10c3.2 0 5.8 2.4 6 5.5l2-.2C20.2 11.3 16.8 8 12.5 8z" /></svg>
                </button>
            }

            @if (CanSaveEdit)
            {
                <button type="button" title="Salvar geometria" aria-label="Salvar geometria" @onclick="SaveEditAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                </button>
            }

            <button type="button" title="Cancelar desenho" aria-label="Cancelar desenho" @onclick="tool.CancelAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 5.7 18.3 4.3 16.9 9.2 12 4.3 7.1l1.4-1.4 4.9 4.9 6.3-6.3z" /></svg>
            </button>
        }
        else if (tool.ShowToolbarTrigger && tool.Modes.Count > 0)
        {
            <button type="button"
                    title="Desenhar no mapa"
                    aria-label="Desenhar no mapa"
                    aria-expanded="@(IsMenuOpen ? "true" : "false")"
                    @onclick="ToggleDrawingAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.3V21h3.7L17.9 9.8l-3.7-3.7zm17.7-10.5c.4-.4.4-1 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0l-1.8 1.8 3.7 3.7z" /></svg>
            </button>

            @if (IsMenuOpen && tool.Modes.Count > 1)
            {
                @foreach (var mode in tool.Modes)
                {
                    <button type="button"
                            class="gisora-map-toolbar__mode"
                            title="@mode.Label"
                            aria-label="@mode.Label"
                            @onclick="() => StartAsync(tool, mode)">
                        @ModeIcon(mode.Kind)
                    </button>
                }
            }
        }

        @if (tool.Error is not null)
        {
            <span class="gisora-map-toolbar__error" role="alert">@tool.Error</span>
        }
    }
</div>

@code {
    private bool IsMenuOpen { get; set; }

    [Parameter]
    public bool CanEditSelection { get; set; }

    [Parameter]
    public EventCallback OnEditSelection { get; set; }

    [Parameter]
    public bool CanSaveEdit { get; set; }

    [Parameter]
    public EventCallback OnSaveEdit { get; set; }

    [CascadingParameter]
    private MapView? Map { get; set; }

    private DrawingTool? Tool => Map?.DrawingTool;

    protected override void OnInitialized()
    {
        if (Map is not null)
        {
            Map.DrawingStateChanged += HandleDrawingStateChanged;
        }
    }

    private Task ZoomInAsync() => Map?.ZoomInAsync() ?? Task.CompletedTask;

    private Task ZoomOutAsync() => Map?.ZoomOutAsync() ?? Task.CompletedTask;

    private Task FitAsync() => Map?.FitBoundsAsync() ?? Task.CompletedTask;

    private async Task ToggleDrawingAsync()
    {
        if (Tool is not { } tool)
        {
            return;
        }

        if (tool.Modes.Count == 1)
        {
            await StartAsync(tool, tool.Modes[0]);

            return;
        }

        IsMenuOpen = !IsMenuOpen;
    }

    private async Task StartAsync(DrawingTool tool, MapDrawingMode mode)
    {
        IsMenuOpen = false;

        await tool.StartAsync(mode);
    }

    private Task EditSelectionAsync() => OnEditSelection.InvokeAsync();

    private Task SaveEditAsync() => OnSaveEdit.InvokeAsync();

    private void HandleDrawingStateChanged() => _ = InvokeAsync(StateHasChanged);

    private static RenderFragment ModeIcon(string kind) => kind switch
    {
        "Point" or "Pick" => builder => builder.AddMarkupContent(0, "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z\" /></svg>"),
        "LineString" => builder => builder.AddMarkupContent(0, "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 18a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm8-8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm8-4a2 2 0 1 1 0-4 2 2 0 0 1 0 4zM5.4 15.2l6.2-4.4.9 1.3-6.2 4.4zm8.9-6.3 4.4-2.6.9 1.5-4.4 2.6z\" /></svg>"),
        _ => builder => builder.AddMarkupContent(0, "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3 2 20h20z\" /></svg>"),
    };

    public void Dispose()
    {
        if (Map is not null)
        {
            Map.DrawingStateChanged -= HandleDrawingStateChanged;
        }
    }
}
