@namespace GISORA.Presentation.Shared.Layout

<nav class="app-nav @(Collapsed ? "app-nav--collapsed" : null) @(MobileOpen ? "app-nav--open" : null)"
     aria-label="Navegacao principal">

    <div class="app-nav__group">
        <span class="app-nav__group-title">Painel</span>

        <NavLink class="app-nav__link" href="" Match="NavLinkMatch.All" title="Visao geral" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="dashboard" /></span>
            <span class="app-nav__label">Visao geral</span>
        </NavLink>
    </div>

    <div class="app-nav__group">
        <span class="app-nav__group-title">Territorio</span>

        <NavLink class="app-nav__link" href="territory" title="Territorio" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="account_tree" /></span>
            <span class="app-nav__label">Territorio</span>
        </NavLink>

        <NavLink class="app-nav__link" href="streets" title="Logradouros" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="signpost" /></span>
            <span class="app-nav__label">Logradouros</span>
        </NavLink>
    </div>

    <div class="app-nav__group">
        <span class="app-nav__group-title">Cadastro</span>

        <NavLink class="app-nav__link" href="properties" title="Imoveis" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="home_work" /></span>
            <span class="app-nav__label">Imoveis</span>
        </NavLink>

        <NavLink class="app-nav__link" href="facilities" title="Equipamentos" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="school" /></span>
            <span class="app-nav__label">Equipamentos</span>
        </NavLink>

        <NavLink class="app-nav__link" href="rural" title="Rural" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="agriculture" /></span>
            <span class="app-nav__label">Rural</span>
        </NavLink>

        <NavLink class="app-nav__link" href="cib" title="Consulta CIB" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="travel_explore" /></span>
            <span class="app-nav__label">Consulta CIB</span>
        </NavLink>
    </div>

    <div class="app-nav__group">
        <span class="app-nav__group-title">Geoprocessamento</span>

        <NavLink class="app-nav__link" href="planning" title="Zoneamento" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="map" /></span>
            <span class="app-nav__label">Zoneamento</span>
        </NavLink>

        <NavLink class="app-nav__link" href="map" title="Mapa" @onclick="Navigate">
            <span class="app-nav__icon" aria-hidden="true"><RadzenIcon Icon="map" /></span>
            <span class="app-nav__label">Mapa</span>
        </NavLink>
    </div>

    <div class="app-nav__footer">
        <RadzenIcon Icon="storage" />
        <span>Dados neste dispositivo</span>
    </div>
</nav>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter]
    public bool MobileOpen { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private Task Navigate() => OnNavigate.InvokeAsync();
}
