@page "/"
@using GISORA.Application.Common
@using GISORA.Application.Geospatial
@using GISORA.Application.Properties
@using GISORA.Application.PublicFacilities
@using GISORA.Application.Roads
@using GISORA.Presentation.Shared.Maps
@using GISORA.Presentation.Shared.Maps.Components
@inject IPropertyQueries PropertyQueries
@inject IUrbanBlockQueries UrbanBlockQueries
@inject IStreetQueries StreetQueries
@inject IFacilityQueries FacilityQueries
@inject IPropertyMapQueries PropertyMapQueries
@inject IGeoJsonSerializer Serializer
@inject IDemoDataSeeder DemoSeeder
@inject GISORA.Presentation.Shared.Layout.MunicipalityState Municipality

<PageHeader Title="Painel territorial"
            Description="Visao consolidada do cadastro e da base geografica do municipio."
            Icon="dashboard" />

<div class="workspace">
    <div class="workspace__map">
        <MapView @ref="_map"
                 CenterLatitude="-7.95"
                 CenterLongitude="-35.25"
                 Zoom="12"
                 Height="var(--map-height-home)"
                 OnReady="ApplyLayersAsync">
            <MapToolbar />
            <LayerControl Layers="_layers" />
            <CoordinateControl Crs="EPSG:4326" />
        </MapView>
    </div>

    <aside class="workspace__side">
        <div class="gisora-grid workspace__stats">
            <StatCard Label="Imoveis" Value="@_properties.ToString("N0")" Hint="Cadastro imobiliario" Icon="home_work" />
            <StatCard Label="Quadras" Value="@_urbanBlocks.ToString("N0")" Hint="Quadras fiscais" Icon="grid_view" />
            <StatCard Label="Logradouros" Value="@_streets.ToString("N0")" Hint="Ruas e avenidas" Icon="signpost" />
            <StatCard Label="Equipamentos" Value="@_facilities.ToString("N0")" Hint="Escolas, saude, pracas" Icon="school" />
        </div>

        <MapLegend Layers="_layers" />

        <RadzenCard class="workspace__panel">
            <h2 class="workspace__panel-title">Base demonstrativa</h2>
            <p class="workspace__panel-text">
                Carrega municipio, bairros, setor, logradouros, imoveis e equipamentos de exemplo.
            </p>

            <RadzenButton Text="Carregar dados de demonstracao"
                          ButtonStyle="ButtonStyle.Primary"
                          Disabled="@_seeding"
                          Click="SeedAsync" />

            @if (_message is not null)
            {
                <p class="workspace__message" role="status">@_message</p>
            }

            @if (_error is not null)
            {
                <p class="workspace__error" role="alert">@_error</p>
            }
        </RadzenCard>

        <p class="workspace__note">
            Dados armazenados neste navegador. Sem autenticacao nesta versao.
        </p>
    </aside>
</div>

@code {
    private MapView? _map;
    private readonly List<MapLayer> _layers = [];
    private bool _loading = true;
    private bool _seeding;
    private bool _applied;
    private int _properties;
    private int _urbanBlocks;
    private int _streets;
    private int _facilities;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ApplyLayersAsync()
    {
        if (_loading || _applied || _map is null)
        {
            return;
        }

        _applied = true;

        foreach (var layer in _layers)
        {
            await _map.SetLayerAsync(layer);
        }

        await _map.FitBoundsAsync();
    }

    private async Task ReloadAsync()
    {
        var properties = await PropertyQueries.SearchAsync(new PropertyFilter { PageSize = 1 });
        var urbanBlocks = await UrbanBlockQueries.SearchAsync(new UrbanBlockFilter { PageSize = 1 });
        var streets = await StreetQueries.SearchAsync(new StreetFilter { PageSize = 1 });
        var facilities = await FacilityQueries.SearchAsync(new FacilityFilter { PageSize = 1 });

        _properties = properties.TotalCount;
        _urbanBlocks = urbanBlocks.TotalCount;
        _streets = streets.TotalCount;
        _facilities = facilities.TotalCount;

        var propertyItems = await PropertyMapQueries.GetMapItemsAsync();
        var facilityItems = await FacilityQueries.GetMapItemsAsync();

        _layers.Clear();

        if (propertyItems.Count > 0)
        {
            _layers.Add(new MapLayer(
                "properties",
                "Imoveis",
                PropertyMapProjector.ToFeatureCollection(propertyItems, Serializer),
                Color: "#1f7a5c"));
        }

        if (facilityItems.Count > 0)
        {
            _layers.Add(new MapLayer(
                "facilities",
                "Equipamentos",
                FacilityMapProjector.ToFeatureCollection(facilityItems, Serializer),
                Color: "#1351b4"));
        }

        _applied = false;
        _loading = false;
    }

    private async Task SeedAsync()
    {
        _seeding = true;
        _error = null;
        _message = null;

        try
        {
            var result = await DemoSeeder.SeedAsync();

            _message = result.AlreadySeeded
                ? "Base demonstrativa ja estava carregada."
                : $"Dados demonstrativos carregados: {result.Properties} imoveis, {result.Streets} logradouros, {result.Facilities} equipamentos.";

            await ReloadAsync();
            await Municipality.RefreshAsync();
            await ApplyLayersAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _seeding = false;
        }
    }
}
